[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
After=user@1001.service
Wants=user@1001.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=fare
Group=fare
ExecStart="/home/fare/.hermes/hermes-agent/.hermes/bin/hermes" "gateway" "run"
WorkingDirectory=/home/fare/.hermes
Environment="HOME=/home/fare"
Environment="USER=fare"
Environment="LOGNAME=fare"
Environment="PATH=/home/fare/.hermes/tools/node-26.12.1-linux-x64/bin:/home/fare/.hermes/tools/npm-12.0.2-linux-x64/bin:/home/fare/.hermes/hermes-agent/node_modules/.bin:/home/fare/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

Environment="HERMES_HOME=/home/fare/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-"/home/fare/.hermes/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.systemd_stop_mark"
ExecStopPost=-"/home/fare/.hermes/hermes-agent/.hermes/bin/hermes" "--run-module" "gateway.cgroup_cleanup"
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
