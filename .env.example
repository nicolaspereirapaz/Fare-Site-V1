# Better Auth (generate a strong random value for local use)
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_DATABASE_PATH=./data/farefoto.sqlite

# XBZ supplier API
XBZ_CNPJ=your-cnpj
XBZ_TOKEN=your-token
XBZ_BASE_URL=https://api.minhaxbz.com.br:5001/api/clientes
XBZ_PRODUCTS_PATH=GetListaDeProdutos

# Spot (Spot Gifts Brasil)
SPOT_CLIENT_ID=your-client-id
SPOT_ACCESS_KEY=your-access-key
SPOT_BASE_URL=https://ws.spotgifts.com.br/api/v1SSL

# Asia Import
ASIA_API_KEY=your-api-key
ASIA_SECRET_KEY=your-secret-key
ASIA_BASE_URL=https://api.asiaimport.com.br/

# Monitoramento (opcional; vazio = desligado). Só carrega depois que o visitante aceita os cookies.
# Google Analytics 4: id da propriedade, ex.: G-ABC123XYZ
FARE_GA_ID=
# Meta Pixel: id numérico do pixel
FARE_META_PIXEL_ID=

# Emissor de NFS-e (área da equipe). Certificado A1 da Fare fora do repositório; senha só no .env.local do servidor.
NFSE_PFX_PATH=
NFSE_PFX_SENHA=
# 2 = produção restrita (teste, sem valor fiscal). 1 = produção (nota de verdade).
NFSE_AMBIENTE=2
# Série da DPS do site (faixa 0 a 49999 de aplicativo próprio; o Emissor web usa 70000).
NFSE_SERIE=1
# % aproximado de tributos do Simples (o Emissor web usa 3.69 para a Fare).
NFSE_PTOTTRIB_SN=3.69
